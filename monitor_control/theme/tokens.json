{
  "$meta": {
    "name": "House Style",
    "source": "House Style Finder, run-mvsm0dv3 + follow-up fu-mvsmkzuw, 2026-10-28",
    "defaultTheme": "dark",
    "profile": {
      "theme": "dark",
      "density": "balanced",
      "radius": "round",
      "type": "geometric (apps) / serif headings (web)",
      "neutral": "cool",
      "hue": "amber",
      "chroma": "muted",
      "amount": "restrained",
      "depth": "soft",
      "ornament": "texture",
      "icons": "filled"
    }
  },
  "color": {
    "dark": {
      "bg": "#0b1016",
      "surface": "#151a21",
      "raised": "#1e232b",
      "sunken": "#060a11",
      "line": "#30363e",
      "line-strong": "#666c75",
      "text": "#e7ecf2",
      "muted": "#9ea5af",
      "accent": "#c9a476",
      "on-accent": "#0b1016",
      "accent-soft": "#3b2a15",
      "accent-text": "#d8b891",
      "success": "#76be86",
      "warning": "#fe8f5b",
      "danger": "#ec6480"
    },
    "light": {
      "bg": "#f2f6fb",
      "surface": "#fdfeff",
      "raised": "#ffffff",
      "sunken": "#eaeff5",
      "line": "#d2dae4",
      "line-strong": "#8a919b",
      "text": "#161b22",
      "muted": "#585e67",
      "accent": "#876438",
      "on-accent": "#ffffff",
      "accent-soft": "#f9ead9",
      "accent-text": "#6f4e21",
      "success": "#287c42",
      "warning": "#c54300",
      "danger": "#b4144e"
    }
  },
  "font": {
    "display-web": [
      "Newsreader",
      "Georgia",
      "serif"
    ],
    "display-app": [
      "Jost",
      "Segoe UI",
      "system-ui",
      "sans-serif"
    ],
    "body-web": [
      "Jost",
      "Segoe UI",
      "system-ui",
      "sans-serif"
    ],
    "body-desktop": [
      "system-ui"
    ],
    "data": [
      "JetBrains Mono",
      "ui-monospace",
      "monospace"
    ]
  },
  "size": {
    "xs": 12,
    "sm": 13,
    "base-desktop": 14,
    "base-web": 16,
    "md": 18,
    "lg": 22,
    "xl": 28,
    "2xl": 35,
    "3xl": 44
  },
  "weight": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "space": {
    "1": 3,
    "2": 6,
    "3": 9,
    "4": 12,
    "5": 18,
    "6": 24,
    "7": 36,
    "8": 48
  },
  "radius": {
    "sm": 6,
    "control": 10,
    "card": 14,
    "pill": 999
  },
  "shadow": {
    "dark": {
      "card": "0 1px 2px rgba(0,0,0,.40), 0 4px 14px rgba(0,0,0,.28)",
      "overlay": "0 8px 32px rgba(0,0,0,.50)"
    },
    "light": {
      "card": "0 1px 2px rgba(20,24,34,.06), 0 4px 14px rgba(20,24,34,.07)",
      "overlay": "0 8px 32px rgba(20,24,34,.16)"
    }
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "easing": "cubic-bezier(.2,.7,.2,1)"
  },
  "texture": {
    "opacity-dark": 0.07,
    "opacity-light": 0.09,
    "frequency": 0.85,
    "use": "large background planes only, never behind dense text"
  }
}